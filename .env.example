# Copie para .env e preencha. O .env NÃO vai para o git.

# De onde vêm os PDFs:
#   local = pasta abaixo (PASTA_EXTRATOS)
#   sftp  = a API de extratos busca no SFTP do cliente (configurado no .env da API). Padrão no Docker.
FONTE_EXTRATOS=local

# Pasta de rede com os extratos (unidade mapeada), usada quando FONTE_EXTRATOS=local
PASTA_EXTRATOS=Z:\A PAGAR\AEROFLEX

# API de leitura de extratos (repo svc-py-tezdbw00-leitura-extratos)
API_EXTRATOS_URL=http://localhost:5000/extratos
API_EXTRATOS_TOKEN=

# Protheus WebApp
PROTHEUS_URL=
PROTHEUS_AMBIENTE=
PROTHEUS_USUARIO=
PROTHEUS_SENHA=
# Homologação assistida: em vez de fazer login, conecta num Chrome já logado por uma pessoa.
# Abrir esse Chrome com: chrome.exe --remote-debugging-port=9222 --user-data-dir=C:\temp\chrome-rpa
# e preencher: PROTHEUS_CDP_URL=http://127.0.0.1:9222   (vazio = robô faz o login sozinho)
PROTHEUS_CDP_URL=
# Navegador instalado na máquina: chrome ou msedge
PROTHEUS_NAVEGADOR=chrome
# true para ver o navegador (homologação/calibração)
PROTHEUS_VISIVEL=true
# true se o servidor usa certificado HTTPS autoassinado (comum em IP interno via VPN).
# Só use com servidor interno conhecido: desliga a verificação do certificado.
PROTHEUS_IGNORAR_CERTIFICADO=false

# Feriados (AAAA-MM-DD separados por vírgula), usados no cálculo de dia útil
FERIADOS=2026-11-02,2026-11-15,2026-11-20,2026-12-25

# Notificação por e-mail (opcional; vazio = só log)
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=
EMAIL_DESTINO_OPERACAO=
EMAIL_DESTINO_TI=

# Saída (relatórios, prints, banco de controle)
PASTA_SAIDA=saida

RPA_API_TOKEN=
